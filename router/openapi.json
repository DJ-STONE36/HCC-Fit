{
  "openapi": "3.1.0",
  "info": {
    "title": "HCC-Fit Strategy API",
    "version": "0.1.1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/strategies": {
      "get": {
        "summary": "List Strategies",
        "operationId": "list_strategies_v1_strategies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "summary": "Search",
        "operationId": "search_v1_search_post",
        "parameters": [
          {
            "name": "X-SciencePal-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Sciencepal-Api-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Scenario": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text",
            "description": "自由文本临床场景；只接受已确认 HCC"
          },
          "disease": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Disease",
            "description": "HCC / hepatocellular carcinoma；其它值会被拒绝"
          },
          "treatment_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Treatment State"
          },
          "time_zero": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Zero"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "horizon_months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizon Months"
          },
          "variables": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Variables"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Scenario"
      },
      "SearchRequest": {
        "properties": {
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy",
            "description": "fast | balanced | auto",
            "default": "auto"
          },
          "k": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "K",
            "description": "1–8；超过 8 会被拒绝，不做静默截断",
            "default": 5
          },
          "deadline_ms": {
            "type": "integer",
            "maximum": 600000.0,
            "minimum": 5000.0,
            "title": "Deadline Ms",
            "default": 120000
          },
          "thinking": {
            "type": "boolean",
            "title": "Thinking",
            "description": "保留字段；本包忽略（deep 未启用）",
            "default": false
          },
          "require_fulltext": {
            "type": "boolean",
            "title": "Require Fulltext",
            "description": "true 时只返回有 PMC 全文的论文",
            "default": true
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "scenario"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}